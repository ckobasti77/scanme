# Generated automatically for local development by `npx convex dev`.
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
CONVEX_DEPLOYMENT=

# Server-only key that unlocks the private landing-page preview.
# Generate a unique 32-character value for every deployed environment.
SCANME_PREVIEW_PASSKEY=

# Optional development-only key used by the documented demo seed command.
# Set the same value in Convex with `npx convex env set SCANME_DEMO_SETUP_KEY <value>`.
SCANME_DEMO_SETUP_KEY=

# Convex Auth and access-control values. Configure these on each Convex
# deployment with `npx convex env set NAME value`; never commit real values.
SITE_URL=https://scanme.rs
SCANME_SITE_URL=https://scanme.rs
SCANME_ADMIN_EMAILS=aleksadjor3@gmail.com
SCANME_ADMIN_SETUP_SECRET=just-a-random-secret-for-admin-setup
SCANME_INVITE_SECRET=just-a-random-secret-for-invites

# HMAC key for the ScanMe Memories guest cookie (RFC-001 §2.6). Used by the
# Next.js route handlers (/r/[cardCode], /api/m/[code]/restore) to sign and
# verify the HttpOnly guest cookie; also declared in convex.config.ts for the
# platform env inventory. Generate a unique 32+ character value per environment
# and set it BOTH in the Next env (Vercel/.env.local) and on the Convex
# deployment (`npx convex env set SCANME_GUEST_SECRET <value>`).
SCANME_GUEST_SECRET=

# Shared secret for the ScanMe Memories image pipeline (RFC-001 §2.8, TASK-15).
# The Next.js route POST /api/m/[code]/process authenticates to the
# secret-gated Convex mutations (convex/memoriesPipeline.ts) with it. Server
# env only — it must never be exposed with a NEXT_PUBLIC_ prefix or reach the
# client. Generate a unique 32+ character value per environment and set it
# BOTH in the Next env (Vercel/.env.local) and on the Convex deployment
# (`npx convex env set SCANME_PIPELINE_SECRET <value>`). Rotation = set a new
# value in both places.
SCANME_PIPELINE_SECRET=

# Resend is used by the Convex invitation action. Set both values separately
# on every Convex deployment; never commit the real API key here.
RESEND_API_KEY=
RESEND_FROM_EMAIL=ScanMe <pozivnice@confirmation.scanme.rs>
# Optional recipient for client service-activation requests.
# Falls back to office@scanme.rs when omitted.
SCANME_ACTIVATION_REQUEST_EMAIL=office@scanme.rs
